<Project>
  <!-- Settings every project shares. Warnings are errors; formatting is checked by `dotnet format`. -->
  <!-- The brand — the app's name, icon and links — comes from Brand.props, if there is one (see Brand.props.example). -->
  <Import Project="$(MSBuildThisFileDirectory)Brand.props" Condition="Exists('$(MSBuildThisFileDirectory)Brand.props')" />
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Product Condition="'$(BrandName)' != ''">$(BrandName)</Product>
    <Copyright Condition="'$(BrandCopyright)' != ''">$(BrandCopyright)</Copyright>
    <!-- The same version as the other editions (the Microsoft Store reads it as four parts: 1.1.0.0) -->
    <Version>0.9.9</Version>
  </PropertyGroup>
</Project>
