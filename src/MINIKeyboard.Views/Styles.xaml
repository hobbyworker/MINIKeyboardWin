<?xml version="1.0" encoding="utf-8"?>
<!-- The app's own looks, on top of WinUI's. Colours come from the theme's brushes, so light and dark follow. -->
<ResourceDictionary
    x:Class="MINIKeyboard.Views.Styles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The interface's font. WinUI's own choice follows the system's locale, and on some — Korean among them — takes
       a font whose backslash is a currency sign; other scripts still fall back to their fonts, character by
       character. -->
  <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- A key cap in the action pages; the active one takes the accent. -->
  <Style x:Key="KeycapButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="8,2,8,3" />
  </Style>
  <Style x:Key="KeycapActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="8,2,8,3" />
  </Style>

  <!-- A cap on the full-size keyboard takes the size it is given. -->
  <Style x:Key="CompactKeycapButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="CompactKeycapActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <!-- A button without a fill until the pointer is over it. -->
  <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <!-- A control on the drawn keyboard: its face is drawn by the canvas; the button only lights up under the
       pointer. -->
  <Style x:Key="CanvasControlButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Highlight.Opacity" Value="0.1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Highlight.Opacity" Value="0.2" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter
                x:Name="ContentPresenter"
                Content="{TemplateBinding Content}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
            <Border
                x:Name="Highlight"
                Background="White"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsHitTestVisible="False"
                Opacity="0" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One choice of a segmented control: the chosen one stands up as a card, with the accent under its label. -->
  <Style x:Key="SegmentedBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style x:Key="SegmentItemStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="Padding" Value="12,4,12,6" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid
              x:Name="Root"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
                    <Setter Target="Pill.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
                    <Setter Target="Pill.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
                    <Setter Target="Pill.Opacity" Value="1" />
                    <Setter Target="Pill.Width" Value="10" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorDisabledBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                    <Setter Target="Pill.Opacity" Value="1" />
                    <Setter Target="Pill.Background" Value="{ThemeResource AccentFillColorDisabledBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Indeterminate" />
                <VisualState x:Name="IndeterminatePointerOver" />
                <VisualState x:Name="IndeterminatePressed" />
                <VisualState x:Name="IndeterminateDisabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter
                x:Name="ContentPresenter"
                Padding="{TemplateBinding Padding}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                Foreground="{TemplateBinding Foreground}" />
            <Border
                x:Name="Pill"
                Width="16"
                Height="3"
                Margin="0,0,0,1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="1.5"
                Opacity="0" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text. -->
  <Style x:Key="DimTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="CaptionDimTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
  <!-- The app's name in the title bar while the window is in the background, as WinUI's title bar has it. -->
  <Style x:Key="CaptionFaintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
  </Style>
  <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="AccentCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="UnsavedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
  </Style>
  <Style x:Key="MonoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
  </Style>
  <Style x:Key="MonoDimTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonoTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="LogTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonoTextStyle}">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="LogDimTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LogTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- Icons. -->
  <Style x:Key="DimIconStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="FaintIconStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
  </Style>
  <Style x:Key="OutputIconStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="InputIconStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
  </Style>

  <!-- Surfaces. -->
  <Style x:Key="LayerStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
  </Style>
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style x:Key="PreviewBoxStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style x:Key="ChipStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,2,8,3" />
  </Style>
  <Style x:Key="DividerStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
  </Style>
  <Style x:Key="NoticeBackgroundStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
  </Style>
  <Style x:Key="SwatchBorderStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- The header's dot: connected, simulated (the simulator's orange, KeyboardCanvas.SimulatorOrange), waiting, not
       connected. -->
  <Style x:Key="DotConnectedStyle" TargetType="Ellipse">
    <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
  </Style>
  <Style x:Key="DotSimulatedStyle" TargetType="Ellipse">
    <Setter Property="Fill" Value="#C2410C" />
  </Style>
  <Style x:Key="DotWaitingStyle" TargetType="Ellipse">
    <Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
  </Style>
  <Style x:Key="DotOffStyle" TargetType="Ellipse">
    <Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
  </Style>
</ResourceDictionary>
