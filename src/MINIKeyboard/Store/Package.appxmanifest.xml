<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store's package (Distribution=Store). The values in braces come from the brand (Brand.props) at build
     time — the package identity Partner Center gives the app, its name — and the version from Directory.Build.props, so
     this repository holds no brand of its own. The pictures are the brand's too (BrandStoreImages, into Images\). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="{StoreName}" Publisher="{StorePublisher}" Version="{Version}" />

  <Properties>
    <DisplayName>{Name}</DisplayName>
    <PublisherDisplayName>{StorePublisherName}</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- The languages the app speaks, in the codes the Store takes (its list of supported languages) — the Store lists the
       package in these. Latin America's Spanish is es-419, as the app's own. -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="ko-KR" />
    <Resource Language="ja-JP" />
    <Resource Language="zh-Hans" />
    <Resource Language="zh-Hant" />
    <Resource Language="es-ES" />
    <Resource Language="es-419" />
    <Resource Language="pt-BR" />
    <Resource Language="pt-PT" />
    <Resource Language="fr-FR" />
    <Resource Language="de-DE" />
    <Resource Language="it-IT" />
    <Resource Language="pl-PL" />
    <Resource Language="ru-RU" />
    <Resource Language="id-ID" />
    <Resource Language="vi-VN" />
    <Resource Language="th-TH" />
    <Resource Language="ar-SA" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="{Name}"
        Description="Sets the keys, knobs, layers, delays and lighting of small USB macro keyboards."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <!-- A desktop app with full trust: it opens the keyboard through the HID functions of Windows, as the other builds do.
       (No apostrophes in this file: the build puts the values in with an MSBuild string function.) -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
